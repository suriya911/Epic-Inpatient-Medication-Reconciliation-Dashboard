# Copy to .env and fill in. NEVER commit the filled-in file.
# On Vercel, set these in Project -> Settings -> Environment Variables instead.

# --- Data source mode -----------------------------------------------------------------
# auto     try Epic, fall back to committed fixtures with a visible banner (default)
# live     call Epic and surface failures instead of hiding them
# fixtures never call Epic; serve committed demo data only
DEMO_MODE=auto

# --- Epic sandbox endpoints (defaults are correct; override only if Epic moves them) ---
EPIC_FHIR_BASE=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_AUTHORIZE_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/authorize

# --- Backend services app (the no-login path the public demo uses) ---------------------
EPIC_BACKEND_CLIENT_ID=
# Full contents of private.pem with newlines escaped as \n, on a single line.
EPIC_PRIVATE_KEY=
# Must match the "kid" in public/.well-known/jwks.json
EPIC_JWK_KID=epic-recon-1

# --- Standalone launch app (the optional interactive "Sign in with Epic" path) ---------
EPIC_PATIENT_CLIENT_ID=
EPIC_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Clinical defaults ----------------------------------------------------------------
# Sandbox test patient shown when none is selected (verify the ID at fhir.epic.com).
DEFAULT_PATIENT_ID=erXuFYUfucBZaryVksYEcMg3
# How late a dose may be and still count as on time. Capped at half the dosing interval.
RECON_GRACE_MINUTES=60
# Past this multiple of the dosing interval, an unadministered dose becomes MISSED.
RECON_MISS_MULTIPLIER=2.0
# Per-request timeout for Epic calls, in seconds.
EPIC_HTTP_TIMEOUT=8.0
